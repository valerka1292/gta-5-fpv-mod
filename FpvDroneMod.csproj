<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FpvDroneMod</AssemblyName>
    <RootNamespace>FpvDroneMod</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <NoWarn>1591;CS1701;CS1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ManagedBass" Version="3.1.0" />
    <PackageReference Include="ManagedBass.Fx" Version="3.0.0" />
    <!-- Costura.Fody — автоматически встраивает все DLL -->
    <PackageReference Include="Costura.Fody" Version="5.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.8.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>libs\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- Нативные DLL вшиваются в сборку как ресурсы -->
  <ItemGroup>
    <EmbeddedResource Include="libs\native\bass.dll">
      <LogicalName>bass.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="libs\native\bass_fx.dll">
      <LogicalName>bass_fx.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Звуковые файлы вшиваются в сборку как ресурсы -->
  <ItemGroup>
    <EmbeddedResource Include="sound\drone_start.mp3">
      <LogicalName>drone_start.mp3</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="sound\drone_fly.mp3">
      <LogicalName>drone_fly.mp3</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>